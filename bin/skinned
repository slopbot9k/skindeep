#!/bin/sh
# skinned: run a terminal CLI inside a skindeep window, as this
# checkout's build/release/skinned, which install.sh builds. The app
# checks its own options, writes its own log under the state directory
# and exits with the CLI's status.

# This file itself, past any link to it.
self=$0
while [ -L "$self" ]; do
  link=$(readlink "$self") || exit 125
  case "$link" in
    /*) self=$link ;;
    *) self=$(dirname "$self")/$link ;;
  esac
done
repo=$(cd "$(dirname "$self")/.." && pwd -P) || exit 125
app="$repo/build/release/skinned"
if [ ! -x "$app" ]; then
  echo "skinned: $app missing, run $repo/install.sh" >&2
  exit 125
fi
exec "$app" "$@"
